  "rationale": {
    "USER-AGENT": "Target clients do not expose HTTP user-agent routing in native rule sets.",
    "URL-REGEX": "Target clients route before full HTTP URL matching; no widening to a shared domain is approved.",
    "IP-ASN": "sing-box headless rule sets have no ASN field; CIDR expansion is not accepted without a pinned ASN data source.",
    "AND": "Logical Surge rules require per-rule semantic conversion and are not flattened.",
    "MIXED-RESOLUTION": "Mixed inputs are conservatively evaluated before DNS resolution so no-resolve intent is not widened.",
    "PROCESS-NAME-WILDCARD": "sing-box process_name is exact-only; Surge process globs are omitted rather than narrowed to a literal name."
  }
